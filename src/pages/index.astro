---
import 'non.geist';
import 'non.geist/mono';
import { Moon, Sun, Mail } from '@lucide/astro';

type DetailPart = string | { text: string; highlight: true };

const mark = (text: string): DetailPart => ({ text, highlight: true });

const experiences = [
  {
    company: "Workday",
    logo: "/workday.png",
    role: "Software Engineer",
    period: "2025 - Present",
    details: [
      [mark("Architected a Java/Log4j redaction framework"), " across ", mark("10 microservices"), ", coordinating rollout and testing with service owners."],
      ["Built a ", mark("secure Java lookup tool"), " to map internal IDs to sensitive data through ", mark("controlled access paths"), " without weakening obfuscation controls."],
      ["Developed an ", mark("AI-powered living documentation and agentic Q&A system"), " that summarizes code from ", mark("AST leaf nodes upward"), ", keeping docs synchronized and answering developer queries."]
    ]
  },
  {
    company: "Workday",
    logo: "/workday.png",
    role: "Software Engineer Intern",
    period: "2024 - 2024",
    details: [
      ["Engineered ", mark("4 Java/Spring Boot APIs"), " for database bootstrapping and multi-tenant initialisation, supporting ", mark("Adaptive Planning's migration"), " to Workday's unified cloud platform."],
      ["Implemented transactional rollback, SQL fixes for import defects, and a ", mark("database-simulating test framework"), " achieving ", mark("92% line coverage"), ", improving tenant migration reliability."]
    ]
  },
  {
    company: "ChannelSight",
    logo: "/channelsight.png",
    role: "Software Engineer Intern",
    period: "2023 - 2023",
    details: [
      ["Developed ", mark("web crawlers"), " for ecommerce product and review data, analyzing ", mark("DOM structures and network traffic"), " to create resilient selectors and extraction logic."],
      ["Implemented ", mark("proxy rotation, custom request headers, and rate limiting"), " to reduce scraper failures from layout changes and ", mark("bot-detection mechanisms"), "."]
    ]
  },
  {
    company: "Trinity College Dublin",
    logo: "/trinity-college-dublin.jpg",
    role: "Class Representative",
    period: "2022 - 2023",
    details: [
      ["Elected as ", mark("class representative"), " for around ", mark("60 Integrated Computer Science students"), ", acting as a liaison between students and faculty to address concerns and improve the ", mark("academic experience"), "."]
    ]
  }
];

const projects = [
  {
    title: "AutoSubs",
    href: "https://github.com/tmoroney/auto-subs",
    date: "Nov. 2023 - Present",
    summary: "Open-source, cross-platform desktop app for video creators to generate, translate, label speakers with unique per-speaker styling, and place subtitles directly into video editor timelines. Built with React/TypeScript, Rust, WebView, LuaJIT, and custom Adobe extensions.",
    details: [
      ["Built and maintained over 2+ years with ", mark("3.5K+ stars and 400K+ downloads"), ", using a ", mark("Rust backend"), " to stay under 200MB idle alongside video editors."],
      ["Developed editor integrations for DaVinci Resolve via an embedded ", mark("LuaJIT HTTP bridge"), " and Adobe apps via custom extensions for ", mark("timeline audio extraction and subtitle placement"), "."],
      ["Implemented ", mark("audio preprocessing and on-device model management"), ", automatic language-based model selection, translation, and a formatting engine optimized for ", mark("CJK, Korean, RTL, Indic, and SE Asian"), " line-breaking and timing constraints."]
    ],
    tags: ["Rust", "TypeScript", "React", "Lua", "3.5K+ stars", "400K+ downloads"]
  },
  {
    title: "Beyond Automation: AI Framework for Intelligent Cinematographic Editing",
    href: "https://drive.google.com/file/d/1zNl1KtIq2jHFq87_K8YLuDgQVhoTLSwD/view?usp=sharing",
    date: "Sep. 2024 - Apr. 2025",
    summary: "Multimodal video-editing framework that reached 72.5% shot attribute classification accuracy, fusing visual composition, optical flow, audio-temporal patterns, and narrative reasoning for next-shot recommendations.",
    details: [
      ["Achieved ", mark("72.5% accuracy"), " in shot attribute classification, a ", mark("16 percentage point improvement"), " over the Anatomy of Video Editing benchmark."],
      ["Developed a ", mark("multimodal pipeline optimized for Apple's MLX framework"), ", enabling real-time, on-device inference by fusing visual composition, optical flow, and audio-temporal patterns."],
      ["Implemented a ", mark("narrative reasoning engine"), " for next-shot recommendations using ", mark("VLMs and LLMs"), " to bridge technical pattern recognition and semantic story comprehension."]
    ],
    tags: ["PyTorch", "MLX", "VLMs", "LLMs", "Video AI"]
  }
];

const siteTitle = "Tom Moroney - Software Engineer";
const siteDescription = "Software engineer in Dublin working on backend security, developer tooling, AI-assisted documentation, and creator-focused video tools.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const previewImageUrl = new URL("/social-preview.jpg", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content={previewImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tom Moroney, software engineer at Workday" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tom Moroney" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={previewImageUrl} />
    <meta name="twitter:image:alt" content="Tom Moroney, software engineer at Workday" />
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const preferredTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      document.documentElement.dataset.theme = savedTheme || preferredTheme;
    </script>
  </head>
  <body>
    <main class="site-shell">
      <header class="intro reveal" style="--delay: 80ms">
        <img class="avatar" src="/me.jpg" alt="Tom Moroney" />
        
        <div class="intro-profile">
          <div class="profile-details">
            <h1>Tom Moroney</h1>
            <p class="subtitle">Software Engineer at Workday</p>
          </div>
          <div class="profile-actions">
            <a class="email-btn" href="mailto:tom.moroney.dev@gmail.com" aria-label="Email"><Mail size={18} stroke-width={2} /></a>
            <a class="linkedin-btn" href="https://www.linkedin.com/in/tom-moroney1/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect width="4" height="12" x="2" y="9"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
            <a class="github-btn" href="https://github.com/tmoroney" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                <path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
            </a>
          </div>
        </div>

        <p>
          I'm a software engineer from Dublin, currently working full-time at <a href="https://www.workday.com/">Workday</a> on backend security and developer tooling for enterprise systems, including sensitive-data redaction, controlled access workflows, and AI-assisted documentation.
        </p>
        <p>
          Outside of work, I build <a href="https://github.com/tmoroney/auto-subs">AutoSubs</a>, an open-source, cross-platform desktop app helping hundreds of thousands of creators automatically generate subtitles for their videos in any language, saving them time while making their videos more engaging and accessible to global audiences. I'm also developing <a href="https://subslate.app/">SubSlate</a>, a new kind of video editor.
        </p>
        <p>
          If you wish to get in contact, drop me an email at <a href="mailto:tom.moroney.dev@gmail.com">tom.moroney.dev@gmail.com</a>.
        </p>
      </header>

      <section class="section reveal" style="--delay: 260ms" aria-labelledby="experience-title">
        <div class="section-header">
          <h2 id="experience-title">Experience</h2>
        </div>

        <div class="experience-list">
          {experiences.map((item) => (
            <article class="experience-item">
              <details class="role">
                <summary>
                  <div class="experience-header">
                    <div class="experience-left">
                      <img src={item.logo} alt={`${item.company} logo`} class="experience-logo" loading="lazy" />
                      <div class="experience-title">
                        <span class="role-text">{item.role}</span>
                        <span class="at-text">at</span>
                        <span class="company-text">{item.company}</span>
                      </div>
                    </div>
                    <div class="experience-right">
                      <time>{item.period}</time>
                      <span class="chevron" aria-hidden="true"></span>
                    </div>
                  </div>
                </summary>
                <div class="experience-details">
                  <ul class="detail-list">
                    {item.details.map((detail) => (
                      <li>
                        {detail.map((part) => typeof part === "string" ? part : <strong>{part.text}</strong>)}
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            </article>
          ))}
        </div>
      </section>

      <section class="section reveal" style="--delay: 440ms" aria-labelledby="projects-title">
        <div class="section-header">
          <h2 id="projects-title">Featured Projects</h2>
        </div>

        <div class="project-list">
          {projects.map((project, index) => (
            <article class="project-card">
              <div class="project-visual" aria-hidden="true">
                {index === 0 && <img src="/autosubs.png" alt="AutoSubs screenshot" class="project-image" />}
                {index === 1 && <img src="/masters-project.jpeg" alt="Masters project screenshot" class="project-image" />}
              </div>
              <div class="project-heading">
                <h3><a href={project.href}>{project.title}</a></h3>
                <time>{project.date}</time>
              </div>
              <p>{project.summary}</p>
              <ul class="project-details">
                {project.details.map((item) => (
                  <li>
                    {item.map((part) => typeof part === "string" ? part : <strong>{part.text}</strong>)}
                  </li>
                ))}
              </ul>
              <ul class="tag-list" aria-label={`${project.title} technologies`}>
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <footer class="site-footer reveal" style="--delay: 500ms">
        <span>Tom Moroney &copy; 2026</span>
        <a href="https://www.linkedin.com/in/tom-moroney1/" target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a>
      </footer>
    </main>

    <div class="theme-switcher" role="group" aria-label="Theme switcher">
      <button type="button" data-theme-option="light" aria-label="Use light mode"><Sun size={16} stroke-width={2.5} /></button>
      <button type="button" data-theme-option="dark" aria-label="Use dark mode"><Moon size={16} stroke-width={2.5} /></button>
    </div>

    <script is:inline>
      const buttons = document.querySelectorAll("[data-theme-option]");
      const syncButtons = () => {
        const activeTheme = document.documentElement.dataset.theme;
        buttons.forEach((button) => {
          button.toggleAttribute("aria-pressed", button.dataset.themeOption === activeTheme);
        });
      };

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const theme = button.dataset.themeOption;
          document.documentElement.dataset.theme = theme;
          localStorage.setItem("theme", theme);
          syncButtons();
        });
      });

      window.addEventListener("load", () => {
        document.body.classList.add("is-loaded");
        syncButtons();
      });

      document.querySelectorAll("details.role").forEach((details) => {
        details.addEventListener("toggle", (e) => {
          if (details.open) {
            const listItems = details.querySelectorAll(".detail-list li");
            listItems.forEach((li) => {
              li.classList.remove("animate-in");
              void li.offsetWidth;
              li.classList.add("animate-in");
            });
          } else {
            const listItems = details.querySelectorAll(".detail-list li");
            listItems.forEach((li) => {
              li.classList.remove("animate-in");
            });
          }
        });
      });
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --bg: #ffffff;
    --panel: #ffffff;
    --panel-soft: #f1f1ef;
    --text: #242424;
    --muted: #5f5f5f;
    --faint: #9a9a9a;
    --line: #e4e4e1;
    --tag: #f1f1ef;
    --shadow: 0 14px 34px rgb(0 0 0 / 0.08);
    --max-width: 500px;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #11110f;
    --panel: #1a1917;
    --panel-soft: #24231f;
    --text: #f2eee7;
    --muted: #bcb6ac;
    --faint: #807b73;
    --line: #302e29;
    --tag: #292722;
    --shadow: 0 14px 34px rgb(0 0 0 / 0.32);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: 'Geist-Variable', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
    transition: background 220ms ease, color 220ms ease;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-shell {
    width: min(var(--max-width), calc(100% - 40px));
    margin: 0 auto;
    padding: 96px 0 80px;
  }

  .intro {
    padding-bottom: 56px;
    font-family: 'Geist-Variable', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .avatar {
    display: block;
    width: 42px;
    height: 42px;
    margin-bottom: 24px;
    border-radius: 50%;
    object-fit: cover;
    transition: transform 300ms ease;
    transform-origin: left center;
  }

  .avatar:hover {
    transform: scale(1.8);
  }

  .intro-profile {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 32px;
  }

  .profile-details h1 {
    margin: 0 0 3px 0;
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.3;
    font-family: 'Geist-Variable', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--text);
  }

  .profile-details .subtitle {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
    font-weight: 400;
  }

  .profile-actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .email-btn,
  .linkedin-btn,
  .github-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 999px;
    background: var(--panel-soft);
    color: var(--text);
    border: none;
    box-shadow: none;
    transition: background 150ms ease, opacity 150ms ease;
  }

  .email-btn:hover,
  .linkedin-btn:hover,
  .github-btn:hover {
    background: var(--line);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 3px;
    font-size: 1.12rem;
    line-height: 1.36;
    font-weight: 500;
    font-family: 'Geist-Variable', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .intro p,
  .project-card p {
    color: var(--muted);
    max-width: 66ch;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .project-details {
    margin: 0 0 18px;
    padding: 0;
    max-width: 66ch;
    list-style: none;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .project-details li {
    position: relative;
    padding-left: 18px;
  }

  .project-details li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--faint);
  }

  .project-details li + li {
    margin-top: 13px;
  }

  .experience-details strong,
  .project-details strong {
    color: var(--text);
    font-weight: 560;
  }

  .intro p {
    margin-bottom: 24px;
  }

  .intro p:last-child {
    margin-bottom: 0;
  }

  .intro p a {
    color: var(--text);
    border-bottom: 2px dotted var(--muted);
    transition: border-color 150ms ease, opacity 150ms ease;
  }

  .intro p a:hover {
    border-color: var(--text);
  }

  :root[data-theme="dark"] .intro p a {
    border-color: var(--muted);
  }

  .section {
    padding-top: 16px;
    padding-bottom: 56px;
  }

  .site-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 48px;
    padding-top: 24px;
    color: var(--text);
    font-size: 0.95rem;
  }

  .site-footer a {
    border-bottom: 2px dotted var(--muted);
    transition: border-color 150ms ease, opacity 150ms ease;
  }

  .site-footer a:hover {
    border-color: var(--text);
  }

  :root[data-theme="dark"] .site-footer a {
    border-color: var(--muted);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 36px;
  }

  h2 {
    margin: 0;
    color: var(--text);
    font-size: 1.15rem;
    font-weight: 480;
    font-family: 'GeistMono-Variable', ui-monospace, 'SF Mono', Menlo, Monaco, Consolas, monospace;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    border-top: 1px dashed var(--line);
  }

  .experience-item {
    width: 100%;
    padding: 0 2px;
    border-bottom: 1px dashed var(--line);
  }

  .role {
    width: 100%;
  }

  .role summary {
    display: block;
    list-style: none;
    cursor: pointer;
    outline: none;
  }

  .role summary::-webkit-details-marker {
    display: none;
  }

  .experience-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 20px 0;
    transition: opacity 150ms ease;
  }

  .experience-header:hover {
    opacity: 0.85;
  }

  .experience-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .experience-logo {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    object-fit: cover;
    background: var(--panel);
    box-shadow: 0 0 0 1px var(--line);
  }

  .experience-title {
    display: flex;
    align-items: baseline;
    gap: 5px;
    font-size: 0.95rem;
    color: var(--text);
  }

  .role-text {
    font-weight: 450;
  }

  .at-text {
    color: var(--faint);
    font-weight: 400;
  }

  .company-text {
    font-weight: 500;
  }

  .experience-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .experience-right time {
    color: var(--text);
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .chevron {
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--faint);
    border-bottom: 1.5px solid var(--faint);
    transform: rotate(-45deg);
    transition: transform 180ms ease, border-color 150ms ease;
  }

  .experience-header:hover .chevron {
    border-color: var(--text);
  }

  .role[open] .chevron {
    transform: rotate(45deg);
  }

  .experience-details {
    padding: 0 0 22px 40px;
  }

  .role ul {
    margin: 0;
    padding: 0;
    max-width: 66ch;
    list-style: none;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .role li {
    position: relative;
    padding-left: 18px;
    opacity: 0;
    transform: translateY(12px);
    filter: blur(6px);
  }

  .role li.animate-in {
    animation: fade-up 600ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .role li.animate-in:nth-child(1) {
    animation-delay: 0ms;
  }

  .role li.animate-in:nth-child(2) {
    animation-delay: 100ms;
  }

  .role li.animate-in:nth-child(3) {
    animation-delay: 200ms;
  }

  .role li.animate-in:nth-child(4) {
    animation-delay: 300ms;
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  .role li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--faint);
  }

  .role li + li {
    margin-top: 13px;
  }

  .project-list {
    display: grid;
    gap: 48px;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .project-card {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .project-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 22px;
    margin-bottom: 18px;
    width: 100%;
    min-width: 0;
    flex-wrap: wrap;
  }

  .project-heading h3 {
    margin-bottom: 0;
    min-width: 0;
    line-height: 1.22;
  }

  .project-heading a {
    text-decoration: none;
  }

  .project-heading a:hover {
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .project-card p {
    margin-bottom: 16px;
    overflow-wrap: break-word;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 32px;
    padding: 0;
    list-style: none;
    max-width: 100%;
  }

  .tag-list li {
    padding: 8px 10px;
    border-radius: 4px;
    background: var(--tag);
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 620;
